<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Đăng nhập</title>
<style>
body {
font-family: Arial;
}
form {
width: 360px;
margin: 50px auto;
}                                h1 {
text-align: center;
color: brown;
}
table {
width: 100%;
border-collapse: collapse;
background-color: #d9f0ff;
}
td {
border: 1px solid #999;
padding: 5px;
}
td:first-child {
width: 120px;
}
input[type="text"],
input[type="password"] {
width: 180px;
height: 22px;
}
.nut {
text-align: center;
}
input[type="button"] {
padding: 5px 15px;
}
#ketqua {
text-align: center;
color: blue;
}
</style>
</head>
<body>
<form id="dangnhap">
<h1>Đăng nhập</h1>
<table>
<tr>
<td>Mã người dùng:</td>
<td>
<input type="text" id="maNguoiDung" value="ptnhung">
</td>
</tr>
<tr>
<td>Mật khẩu:</td>
<td>
<input type="password" id="matKhau" value="123456789">
</td>                                                                                                                                                                                                                                                     </tr>
<tr>
<td colspan="2" class="nut">
<input type="button" value="Đồng ý" onclick="dongY()">
</td>
</tr>
<tr>
<td colspan="2" id="ketqua"></td>
</tr>
</table>
</form>
<script>
function dongY() {
var ma = document.getElementById("maNguoiDung").value;
document.getElementById("ketqua").innerText = ma;
}
</script>
</body>
</html>
